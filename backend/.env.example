# Copy this to .env and fill in real values before running a real audit.
# Confirm which model/API you actually have runtime access to under the
# hackathon's Codex allowance FIRST — don't assume the name or endpoint.
# NOTE: Codex models require the Responses API, not the older Chat
# Completions API (OpenAI deprecated that path for Codex). Check your
# account's live model list for the exact current "-codex" model slug.
MODEL_API_URL=https://api.openai.com/v1/responses
MODEL_API_KEY=
MODEL_NAME=REPLACE_ME
DEMO_SITE_PORT=8080
